# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Google Drive Cloud Backup OAuth Credentials
# Do NOT hardcode actual credentials in code or public repositories.
# Set these in the AI Studio Secrets panel.
GOOGLE_OAUTH_CLIENT_ID=ADD_YOUR_CLIENT_ID_HERE
GOOGLE_OAUTH_CLIENT_SECRET=ADD_YOUR_CLIENT_SECRET_HERE
